# AURA private-alpha launch configuration

# Website / checkout
PUBLIC_BASE_URL=https://your-domain.com
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
AURA_WEB_DB_PATH=/var/lib/aura/private-alpha-store.json
AURA_ADMIN_TOKEN=replace-with-long-random-admin-token

# License signing
# Generate with:
#   python scripts/generate-license-key.py --print-env
AURA_VENDOR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
AURA_VENDOR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"

# Desktop/backend local verification
AURA_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
AURA_LICENSE_SERVER_URL=https://your-domain.com

# Apple distribution
APPLE_ID=founder@example.com
APPLE_TEAM_ID=TEAMID1234
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
CSC_NAME="Developer ID Application: Your Company, Inc. (TEAMID1234)"
CSC_LINK=/secure/path/developer-id-certificate.p12
CSC_KEY_PASSWORD=replace_me
